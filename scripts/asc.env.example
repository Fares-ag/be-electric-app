# App Store Connect API credentials (gitignored — copy to asc.env)
# Create key: App Store Connect → Users and Access → Integrations → App Store Connect API
ASC_KEY_ID=YOUR_KEY_ID
ASC_ISSUER_ID=YOUR_ISSUER_UUID
# Path to AuthKey_XXXXXX.p8 (keep outside repo or in ~/.private_keys/)
ASC_PRIVATE_KEY_PATH=/Users/YOU/.private_keys/AuthKey_XXXXXX.p8
