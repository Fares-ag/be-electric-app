# Copy to scripts/db.env (never commit). Used by ./scripts/db.sh
#
# Option A — full connection string (recommended)
# Supabase Dashboard → Project Settings → Database → Connection string → URI
# Use "Session mode" or direct connection (port 5432), not pooler, for psql CLI.
#
# DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Option B — individual vars (db.sh builds DATABASE_URL; password is URL-encoded in Node CLI)
# SUPABASE_PROJECT_REF=sdhqjyjeczrbnvukrmny
# SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD
# SUPABASE_DB_HOST=aws-1-ap-south-1.pooler.supabase.com
# SUPABASE_DB_USER=postgres.sdhqjyjeczrbnvukrmny
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
#
# IPv4 networks: use Session pooler host from Dashboard (not db.*.supabase.co direct).

# Optional — same as Flutter app (for reference / REST tests)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
